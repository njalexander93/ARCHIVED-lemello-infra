# Terraform
.terraform/

# Terraform state (NEVER COMMIT)
*.tfstate
*.tfstate.*

# Terraform plan files (may contain secrets)
*.tfplan
*.plan

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI config (may contain credentials)
.terraformrc
terraform.rc

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment / Secrets
.env
.env.*
!.env.template

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
