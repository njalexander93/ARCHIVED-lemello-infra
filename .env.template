# -----------------------------------------------------------------------------
# TEMPLATE ONLY — DO NOT USE AS REAL SECRETS
#
# Copy this file to `.env` and fill in real values:
#   cp .env.template .env
#
# `.env` must NEVER be committed (see .gitignore). Use strong passwords.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Docker Compose Project
# -----------------------------------------------------------------------------
# Required — Docker Compose: project name for container/network prefixes.
COMPOSE_PROJECT_NAME=lemello-local

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
# Required — PostgreSQL: database superuser name.
POSTGRES_USER=lemello
# Required — PostgreSQL: database superuser password (CHANGE THIS).
POSTGRES_PASSWORD=change_me_strong_password
# Required — PostgreSQL: default database name.
POSTGRES_DB=lemello
# Optional — Docker Compose/PostgreSQL: host port mapping.
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Optional — Docker Compose/Redis: host port mapping.
REDIS_PORT=6379
# Optional — Redis: auth password (empty disables auth).
REDIS_PASSWORD=change_me_optional

# -----------------------------------------------------------------------------
# Backend Service
# -----------------------------------------------------------------------------
# Optional — Docker Compose/Backend: host port mapping.
BACKEND_PORT=8000
# Optional — Docker Compose/Backend: image tag.
BACKEND_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Frontend Service
# -----------------------------------------------------------------------------
# Optional — Docker Compose/Frontend: host port mapping.
FRONTEND_PORT=3000
# Optional — Docker Compose/Frontend: image tag.
FRONTEND_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Shared/Cross-Service
# -----------------------------------------------------------------------------
# Reference — Backend/DB clients: example connection string (keep in sync with POSTGRES_* above).
DATABASE_URL=postgresql://lemello:change_me_strong_password@postgres:5432/lemello
# Reference — Backend/Redis clients: example connection string (keep in sync with REDIS_* above).
REDIS_URL=redis://:change_me_optional@redis:6379/0
